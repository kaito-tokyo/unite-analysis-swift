<installer-gui-script minSpecVersion="2">
  <title>unite-analysis-swift</title>
  <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
  <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="true"/>
  <volume-check>
    <allowed-os-versions>
      <os-version min="26.0"/>
    </allowed-os-versions>
  </volume-check>
  <license file="LICENSE" mime-type="text/plain"/>
  <choices-outline>
    <line choice="default"/>
  </choices-outline>
  <choice id="default" visible="false">
    <pkg-ref id="tokyo.kaito.unite-analysis-swift"/>
  </choice>
  <pkg-ref id="tokyo.kaito.unite-analysis-swift">
    <must-close>
      <app id="tokyo.kaito.unite-analysis-swift"/>
    </must-close>
  </pkg-ref>
  <pkg-ref id="tokyo.kaito.unite-analysis-swift">unite-analysis-swift-component.pkg</pkg-ref>
</installer-gui-script>
