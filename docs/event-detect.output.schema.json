{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaito-tokyo.github.io/unite-analysis-swift/event-detect.output.schema.json",
  "title": "unite-analysis-swift event-detect output",
  "type": "object",
  "required": [
    "$schema",
    "matchId",
    "duration",
    "candidates"
  ],
  "properties": {
    "$schema": {
      "const": "https://kaito-tokyo.github.io/unite-analysis-swift/event-detect.output.schema.json"
    },
    "matchId": {
      "type": "string",
      "minLength": 1
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": [
        "startInmatch",
        "endInmatch",
        "representativeInmatch",
        "constituents"
      ],
      "properties": {
        "startInmatch": {
          "type": "number",
          "minimum": 0
        },
        "endInmatch": {
          "type": "number",
          "minimum": 0
        },
        "representativeInmatch": {
          "type": "number",
          "minimum": 0
        },
        "constituents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/constituent"
          }
        }
      }
    },
    "constituent": {
      "type": "object",
      "required": [
        "source",
        "inmatch"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^(audio|scheduled|chroma:.+|ocr:.+)$"
        },
        "inmatch": {
          "type": "number",
          "minimum": 0
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "description": "Source-native nonnegative ranking score for audio or chroma constituents; omitted for OCR and scheduled constituents. Scores from different sources or chroma regions are not comparable."
        },
        "value": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Apple Vision recognition confidence for OCR constituents, from 0 through 1; omitted for audio, chroma, and scheduled constituents."
        }
      }
    }
  }
}
