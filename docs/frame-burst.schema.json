{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaito-tokyo.github.io/unite-analysis-swift/frame-burst.schema.json",
  "title": "unite-analysis-swift frame burst job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "matchTimestamp",
    "source",
    "cellWidth",
    "output"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "matchTimestamp": {
      "type": "number"
    },
    "source": {
      "$ref": "#/$defs/rectangle"
    },
    "cellWidth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32768
    },
    "output": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
