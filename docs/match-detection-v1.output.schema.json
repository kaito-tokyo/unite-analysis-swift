{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaito-tokyo.github.io/unite-analysis-swift/match-detection-v1.output.schema.json",
  "title": "Pokémon Unite match detection output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "source",
    "mainMediaFile",
    "layoutId",
    "gameScreen",
    "matches",
    "diagnostics"
  ],
  "properties": {
    "$schema": {
      "const": "https://kaito-tokyo.github.io/unite-analysis-swift/match-detection-v1.output.schema.json"
    },
    "source": {
      "const": "videoOCR",
      "description": "Detection input; the LDTX main video is decoded and OCRed directly."
    },
    "mainMediaFile": {
      "type": "string",
      "minLength": 1
    },
    "layoutId": {
      "type": "string",
      "minLength": 1
    },
    "gameScreen": {
      "$ref": "#/$defs/rectangle"
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "matchId",
          "recordingPTSStart",
          "recordingPTSEnd",
          "duration",
          "observationCount"
        ],
        "properties": {
          "matchId": {
            "type": "string",
            "pattern": "^match-[0-9]{2,}$"
          },
          "recordingPTSStart": {
            "type": "number",
            "minimum": 0
          },
          "recordingPTSEnd": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "const": 600,
            "description": "Only standard 10-minute matches are currently modeled."
          },
          "observationCount": {
            "type": "integer",
            "minimum": 2
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "description": "One deterministic adopted/excluded decision for every timer Vision observation.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recordingTimelineMilliseconds",
          "output",
          "disposition",
          "reason"
        ],
        "properties": {
          "recordingTimelineMilliseconds": {
            "type": "integer",
            "minimum": 0
          },
          "output": {
            "type": "string"
          },
          "imageFileName": {
            "type": "string",
            "description": "Optional source image beside the Vision JSON, retained for human audit/contact-sheet generation."
          },
          "confidence": {
            "description": "Apple Vision confidence for the selected raw timer OCR candidate, or null when no text was recognized.",
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "remainingSeconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 600
          },
          "startCandidate": {
            "type": [
              "number",
              "null"
            ]
          },
          "disposition": {
            "enum": [
              "accepted",
              "excluded"
            ]
          },
          "reason": {
            "enum": [
              "consistentStandardMatchCluster",
              "invalidMMSS",
              "isolatedStartRequiresCorroboration",
              "noConsistentCluster",
              "startBeforeRecording",
              "endAfterRecording",
              "overlapsPreviousMatch"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "description": "Display-oriented main-video pixels, top-left origin, half-open bounds.",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
