{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaito-tokyo.github.io/unite-analysis-swift/match-detection-v2.output.schema.json",
  "title": "Pokémon Unite evidence-backed match detection output v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "source",
    "mainMediaFile",
    "layoutId",
    "gameScreen",
    "supportedModes",
    "matches",
    "timerDiagnostics",
    "endEvidenceDiagnostics",
    "unclassifiedCandidates"
  ],
  "properties": {
    "$schema": {
      "const": "https://kaito-tokyo.github.io/unite-analysis-swift/match-detection-v2.output.schema.json"
    },
    "source": {
      "const": "videoOCR+declaredEndEvidence"
    },
    "mainMediaFile": {
      "type": "string",
      "minLength": 1
    },
    "layoutId": {
      "type": "string",
      "minLength": 1
    },
    "gameScreen": {
      "$ref": "#/$defs/rectangle"
    },
    "supportedModes": {
      "const": [
        "standard10Minute",
        "quick5Minute"
      ],
      "description": "Only these modes can be classified by v2."
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "matchId",
          "recordingPTSStart",
          "recordingPTSEnd",
          "duration",
          "mode",
          "completion",
          "observationCount",
          "endEvidenceIds"
        ],
        "properties": {
          "matchId": {
            "type": "string",
            "pattern": "^match-[0-9]{2,}$"
          },
          "recordingPTSStart": {
            "type": "number",
            "minimum": 0
          },
          "recordingPTSEnd": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 600
          },
          "mode": {
            "enum": [
              "standard10Minute",
              "quick5Minute"
            ]
          },
          "completion": {
            "enum": [
              "completed",
              "surrendered"
            ]
          },
          "observationCount": {
            "type": "integer",
            "minimum": 2
          },
          "endEvidenceIds": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "timerDiagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timerDiagnostic"
      }
    },
    "endEvidenceDiagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/endEvidenceDiagnostic"
      }
    },
    "unclassifiedCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recordingPTSStart",
          "nominalDuration",
          "mode",
          "observationCount",
          "reason"
        ],
        "properties": {
          "recordingPTSStart": {
            "type": "number",
            "minimum": 0
          },
          "nominalDuration": {
            "enum": [
              300,
              600
            ]
          },
          "mode": {
            "enum": [
              "standard10Minute",
              "quick5Minute"
            ]
          },
          "observationCount": {
            "type": "integer",
            "minimum": 2
          },
          "reason": {
            "enum": [
              "missingEndEvidence",
              "contradictoryEvidence",
              "overlapsPreviousMatch"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "timerDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordingTimelineMilliseconds",
        "output",
        "disposition",
        "reason"
      ],
      "properties": {
        "recordingTimelineMilliseconds": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "string"
        },
        "imageFileName": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "description": "Apple Vision confidence for the selected raw timer OCR candidate, or null when no text was recognized.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "remainingSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 600
        },
        "startCandidate": {
          "type": [
            "number",
            "null"
          ]
        },
        "disposition": {
          "enum": [
            "accepted",
            "excluded"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "endEvidenceDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "recordingPTS",
        "kind",
        "medium",
        "mode",
        "source",
        "disposition",
        "reason"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1
        },
        "recordingPTS": {
          "type": "number",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "matchEnd",
            "surrender"
          ]
        },
        "medium": {
          "enum": [
            "visual",
            "audio"
          ]
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "adopted",
            "excluded"
          ]
        },
        "reason": {
          "enum": [
            "definesMatchEnd",
            "noMatchingCandidate",
            "unsupportedMode",
            "contradictoryEvidence",
            "overlapsPreviousMatch"
          ]
        }
      }
    }
  }
}
