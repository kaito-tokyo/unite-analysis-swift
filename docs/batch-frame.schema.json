{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaito-tokyo.github.io/unite-analysis-swift/batch-frame.schema.json",
  "title": "unite-analysis-swift batch frame job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "matchTimestamps",
    "source",
    "outputPrefix"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "matchTimestamps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "source": {
      "$ref": "#/$defs/rectangle"
    },
    "outputPrefix": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
